{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Launch Backend and Frontend",
      "configurations": ["Launch Django Backend", "Launch React Frontend"]
    }
  ],
  "configurations": [
    {
      "name": "Launch Django Backend",
      "type": "debugpy",
      "request": "launch",
      "module": "homehub.manage",
      "args": ["runserver", "0.0.0.0:8000"],
      "cwd": "${workspaceFolder}/backend",
      "django": true,
      "justMyCode": false,
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "DJANGO_SETTINGS_MODULE": "homehub.smart_home_backend.settings"
      }
    },
    {
      "name": "Launch React Frontend",
      "type": "pwa-node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:",
        "uriFormat": "http://localhost:5173",
        "action": "openExternally"
      },
      "internalConsoleOptions": "neverOpen",
      "restart": true
    }
  ]
}
